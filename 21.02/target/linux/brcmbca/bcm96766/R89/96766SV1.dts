&sysport {
	ethsw_ext = <&switch_sf2_ext>;
};

&mdio_sf2 {
		/* Port PHY mapping:
            port_imp -8#0- port_gphy <----> phy_gphy
                      # 6- port_sgmii1 <--> phy_serdes1 - phy_cascade1
                      ##5- port_sgmii0 <--> phy_serdes0 <--> port_ext_imp -8#0- port_ext_gphy0 <--> phy_ext_gphy0
                                                                           # 1- port_ext_gphy1 <--> phy_ext_gphy1
                                                                           # 2- port_ext_gphy2 <--> phy_ext_gphy2
                                                                           ##3- port_ext_gphy3 <--> phy_ext_gphy3
		 */
	phy_gphy {
		status = "okay";
	};

	phy_serdes0 {
		phy-extswitch;
		config-xfi="2500Base-X";
		phy-xfi-tx-polarity-inverse;
		status = "okay";
	};

	/* PHYs on external SF2 switch */
	phy_ext_gphy0:phy_ext_gphy0 {
		compatible = "brcm,bcaphy";
		phy-type = "EGPHY";
		reg = <0>;
		status = "okay";
	};
	phy_ext_gphy1:phy_ext_gphy1 {
		compatible = "brcm,bcaphy";
		phy-type = "EGPHY";
		reg = <1>;
		status = "okay";
	};
	phy_ext_gphy2:phy_ext_gphy2 {
		compatible = "brcm,bcaphy";
		phy-type = "EGPHY";
		reg = <2>;
		status = "okay";
	};
	phy_ext_gphy3:phy_ext_gphy3 {
		compatible = "brcm,bcaphy";
		phy-type = "EGPHY";
		reg = <3>;
		status = "okay";
	};
};

&switch_sf2_ext {                       /* linux/uboot: external sf2 */
	unit = <1>;
	sw-type = "SF2_SW";

	compatible = "brcm,bcmbca-extsw";
	extswsgmii_addr = <0x6>;
	switch-reset = <&gpioc 27 GPIO_ACTIVE_LOW>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port_ext_gphy0 {
			phy-handle = <&phy_ext_gphy0>;
			reg = <0>;
			mac-type = "SF2MAC";
			phy-mode = "gmii";
			gmii-direct;
			status = "okay";
			mtd-mac-address = <&bdinfo 0xDE00>;
		};
		port_ext_gphy1 {
			phy-handle = <&phy_ext_gphy1>;
			reg = <1>;
			mac-type = "SF2MAC";
			phy-mode = "gmii";
			gmii-direct;
			status = "okay";
			mtd-mac-address = <&bdinfo 0xDE00>;
		};
		port_ext_gphy2 {
			phy-handle = <&phy_ext_gphy2>;
			reg = <2>;
			mac-type = "SF2MAC";
			phy-mode = "gmii";
			gmii-direct;
			status = "okay";
			mtd-mac-address = <&bdinfo 0xDE00>;
		};
		port_ext_gphy3 {
			phy-handle = <&phy_ext_gphy3>;
			reg = <3>;
			mac-type = "SF2MAC";
			phy-mode = "gmii";
			gmii-direct;
			status = "okay";
			mtd-mac-address = <&bdinfo 0xDE00>;
		};
		port_ext_imp {
			management;                     /* sf2_ext.p8 <--> root.p5  when P8_SGMII_SEL=1 */
			reg = <8>;
			mac-type = "SF2MAC";
			shrink-ipg;
			phy-mode = "gmii";
			gmii-direct;
			status = "okay";
		};
	};
};

&switch0 {

	ports {
	   port_gphy {
            phy-handle = <&phy_gphy>;
//          network-leds = <&led0 &led1>;
            status = "okay";
            mtd-mac-address = <&bdinfo 0xDE00>;
            mtd-mac-address-increment = <1>;
        };

		port_sgmii0 {
			phy-handle = <&phy_serdes0>;
			link = <&switch_sf2_ext>;
			shrink-ipg;
			status = "okay";
		};
	};
};

#if defined(CONFIG_BCM_MPM) || defined(CONFIG_BCM_MPM_MODULE)
&dt_reserved_bufmem {
	rsvd-size = <0x8000000>;
};
#endif

#if defined(CONFIG_BCM_PCIE_HCD) || defined(CONFIG_BCM_PCIE_HCD_MODULE)
&pcie0 {
	status = "disabled";
};
#endif //#if defined(CONFIG_BCM_PCIE_HCD) || defined(CONFIG_BCM_PCIE_HCD_MODULE)
&plat_rsvmem_uncached_device {

#ifdef DT_RESERVED_DHD_IN_UNCACHED_DEV
	 dt_reserved_dhd0:dt_reserved_dhd0 {
		rsvd-size = <0>;
	};
	 dt_reserved_dhd1:dt_reserved_dhd1 {
		rsvd-size = <0>;
	};
	 dt_reserved_dhd2:dt_reserved_dhd2 {
		rsvd-size = <0>;
	};
#endif

};
