&led_ctrl {
	led0: sw_parallel_led_0 {
		active_low;
		pinctrl-0 = <&a_per_led_07_pin_7>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:green:internet";
	};
	led1: sw_parallel_led_1 {
		active_low;
		pinctrl-0 = <&a_per_led_06_pin_6>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:red:internet";
	};
	led2: sw_parallel_led_2 {
		active_low;
		pinctrl-0 = <&a_per_led_21_pin_21>;
		brightness = <255>;
		flash_rate = <0>;
		status = "okay";
		label = "oem:green:wifi";
	};
	led3: sw_parallel_led_3 {
		active_low;
		pinctrl-0 = <&a_per_led_10_pin_10>;
		brightness = <255>;
		flash_rate = <0>;
		status = "okay";
		label = "oem:green:wan";
	};
	led4: sw_parallel_led_4 {
		active_low;
		pinctrl-0 = <&a_per_led_12_pin_12>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:green:wan2";
	};
	led6: sw_parallel_led_6 {
		active_low;
		pinctrl-0 = <&a_per_led_15_pin_15>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:green:status";
	};
	led7: sw_parallel_led_7 {
		active_low;
		pinctrl-0 = <&a_per_led_19_pin_19>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:green:wps";
	};
	led8: sw_parallel_led_8 {
		active_low;
		pinctrl-0 = <&a_per_led_20_pin_20>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:green:lan4";
	};
	led9: sw_parallel_led_9 {
		active_low;
		pinctrl-0 = <&a_per_led_00_pin_0>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:green:lan3";
	};
	
	led10: sw_parallel_led_10 {
		active_low;
		pinctrl-0 = <&a_per_led_16_pin_16>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:green:lan2";
	};
	
	led11: sw_parallel_led_11 {
		active_low;
		pinctrl-0 = <&a_per_led_04_pin_4>;
		brightness = <255>;
		flash_rate = <0>;
		status="okay";
		label="oem:green:lan1";
	};	
};
