--- ./userspace/private/apps/wlan/wlssk/wlssk.c
+++ ./userspace/private/apps/wlan/wlssk/wlssk.c
@@ -111,6 +111,43 @@
 
 char vifslist[1024] = {0};
 
+#ifdef RDK_BUILD
+#define WIFI_SETUP_FEATURE_FILE "/tmp/wifi_setup_feature.txt"
+int check_feature(char *feature, char *result)
+{
+	FILE * fp;
+	char * line = NULL;
+	size_t len = 0;
+	ssize_t read = 0;
+	int ret = 0;
+	fp = fopen(WIFI_SETUP_FEATURE_FILE, "r");
+	if (fp) {
+		while ((read = getline(&line, &len, fp)) != -1) {
+			if (strncmp(line, feature, read-1) == 0) {
+				ret = 1;
+				break;
+			}
+		}
+		fclose(fp);
+		if (line)
+			free(line);
+	}
+
+	if (ret == 0 && result) {
+		char tmp[256] = {0};
+		if (snprintf(tmp, 256, "/proc/environment/%s", feature) > 0 &&
+			(fp = fopen(tmp, "r"))) {
+			if ((fgets(tmp, 256, fp)) && (!strncmp(tmp, result, strlen(result))))
+				ret = 1;
+			fprintf(stderr, "%s:%d-feature:%s, tmp:%s\n", __FUNCTION__, __LINE__,
+				feature, tmp);
+			fclose(fp);
+		}
+	}
+	return ret;
+}
+#endif /* RDK_BUILD */
+
 void wlssk_init(void)
 {
 	char *restore = NULL;
