 static struct argp argp = { options, parse_opt, "[FILES]", argp_doc };
 
+void print_error_prefix(void)
+{
+  time_t t;
+  char buf[20];
+
+  if (timestamp_output) {
+    t = time(NULL);
+    if (strftime(buf, 20, "%Y-%m-%d %H:%M:%S", localtime(&t)))
+      fprintf(stderr, "%s ", buf);
+  }
+  fprintf(stderr, "prelink: ");
+}
