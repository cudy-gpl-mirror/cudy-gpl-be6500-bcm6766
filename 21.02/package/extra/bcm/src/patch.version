- {csp: CS00012355885, ref: SWBCACPE-61941, chg: CL505722} # update BCM6766/6765/6764 PMC firmware and BCM thermal driver
- {csp: CS00012371316, ref: SWBCACPE-XXXXX, chg: CL521948} # (JIRA list not included) Performance enhancement patch to go with 23.2.1/2 WLAN driver release
- {csp: CS00012371316, ref: SWBCACPE-61512, chg: CL523127} # better spc aggregation for 6764
- {csp: CS00012378421, ref: SWBCACPE-61013, chg: CL527701} # fix 2.5G-USXGMII at 1G causes MAC Rx counter to lock up
